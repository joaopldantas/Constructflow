# Copie para .env e ajuste. Lido pelo docker compose e pode ser exportado para a API.

# Banco (docker-compose.yml)
DB_NAME=constructflow
DB_USER=postgres
DB_PASS=postgres
DB_PORT=5432

# API (application.properties)
DB_URL=jdbc:postgresql://localhost:5432/constructflow
# Gere com: openssl rand -base64 32
JWT_SECRET=

# Administrador inicial (criado no startup se não houver nenhum ADMIN)
ADMIN_EMAIL=admin@constructflow.dev
ADMIN_SENHA=
